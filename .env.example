# AttenGene configuration
#
# Copy this file to `.env` and edit the values that apply to you. Every
# variable has a sensible default for a local Docker-Compose stack; you
# only need to override the ones that point at services on your network.
#
# Quickstart (Docker Compose):
#
#   cp .env.example .env
#   docker compose up -d
#   curl http://localhost:8000/health
#
# Full documentation: see README.md.


# ----------------------------------------------------------------------
# LLM backend (any OpenAI-compatible chat-completions endpoint)
# ----------------------------------------------------------------------
#
# AttenGene calls out to your choice of LLM server. It speaks the standard
# OpenAI `/v1/chat/completions` shape, so you can point it at:
#
#   - llama.cpp's llama-server (recommended for self-hosting)
#   - Ollama (`http://localhost:11434/v1/chat/completions`)
#   - vLLM, LM Studio, Text Generation Inference, etc.
#   - OpenAI, Mistral, Together, etc. (note: cloud LLMs see your queries)
#
# The default below assumes a llama-server running on the host machine.
BACKEND_LOCAL_URL=http://host.docker.internal:8080/v1/chat/completions

# Upstream model name. `auto` calls GET <BACKEND_LOCAL_URL>/models on
# startup and pins whatever the server reports. Override only if your
# server doesn't implement the /models endpoint.
BACKEND_LOCAL_MODEL=auto

# Optional bearer token for the local backend. Leave empty for a no-auth
# server (e.g. a default Ollama/llama-server). When set, every outbound
# call carries `Authorization: Bearer <key>` - use it if your llama-server
# runs with --api-key.
BACKEND_LOCAL_KEY=

# Expose a second model id, `attengene-dev`, on /v1/models. It uses the same
# local LLM as `attengene-local` but runs the RAG pipeline in "dev" mode, so
# in-development features can be tested live from the UI's model dropdown
# without touching the stable path. Leave unset/off for production; set to
# 1/true/yes/on to enable.
BACKEND_DEV_ENABLED=


# ----------------------------------------------------------------------
# Embeddings server (BAAI/bge-large-en-v1.5, 1024-dim)
# ----------------------------------------------------------------------
#
# AttenGene calls an HTTP embeddings server. The bundled Compose stack
# ships one (CPU by default, GPU via `--profile gpu`) and wires it up
# for you. The expected URL shape matches HuggingFace's TEI
# (text-embeddings-inference) /embed endpoint, so any TEI server or
# compatible service works without code changes.
EMBEDDINGS_URL=http://embeddings:8081/embed

# Timeout for embedding HTTP calls (seconds).
EMBEDDINGS_TIMEOUT=10.0

# Documents per HTTP call. 32 is fine for the bundled CPU server;
# bump to 256-512 when pointing at a GPU server.
EMBEDDINGS_BATCH_SIZE=256


# ----------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ----------------------------------------------------------------------
#
# The Compose stack runs pgvector for you on `db:5432`. Change these
# only if you're bringing your own PostgreSQL.
DB_HOST=db
DB_PORT=5432
DB_NAME=attengene
DB_USER=attengene
DB_PASSWORD=changeme


# ----------------------------------------------------------------------
# API authentication
# ----------------------------------------------------------------------
#
# Leave empty to disable auth (fine for local dev or single-user). For
# any deployment with more than one client, set this to a random secret
# (e.g. `python -c 'import secrets; print(secrets.token_hex(32))'`) and
# pass it as `Authorization: Bearer <token>` from your clients.
ATTENGENE_API_KEY=

# ----------------------------------------------------------------------
# Behavior
# ----------------------------------------------------------------------
#
# Retrieval trace: when streaming, prepend a collapsible "Retrieval trace"
# block to the answer showing which databases were searched, how many hits
# each returned, and the top hit. Useful for transparency and debugging
# routing. Set to 0/false/off to disable for a cleaner end-user UI.
RAG_TRACE=1
